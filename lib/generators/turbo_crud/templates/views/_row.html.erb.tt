<%# Row partial: this is what we insert/replace/remove with Turbo Streams. %>

<div id="<%%= dom_id(<%= singular_name %>) %>" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <%= @generated_row_fields %>
      <%% if <%= singular_name %>.respond_to?(:updated_at) && <%= singular_name %>.updated_at.present? %>
        <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">Updated <%%= time_ago_in_words(<%= singular_name %>.updated_at) %> ago</p>
      <%% end %>
    </div>

    <div class="flex items-center gap-2">
      <%%= <%= edit_link_helper %> "Edit", edit_<%= singular_name %>_path(<%= singular_name %>),
        class: "inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-50" %>

      <%%= button_to "Delete", <%= singular_name %>_path(<%= singular_name %>),
        method: :delete,
        form: { data: { turbo_confirm: "Delete this?" } },
        class: "inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" %>
    </div>
  </div>
</div>
